  "runtime_hosts": [
    "apk_runtime",
    "magisk_backend"
  ],
  "schema_version": 1,
  "semantic_bounds": {
    "android.notification.live_references": 256,
    "android.notification.reference_ttl_seconds": 300,
    "automation.execution_budget_ms": 3600000,
    "automation.expanded_visits": 10000,
    "automation.state_keys": 64,
    "automation.tree_depth": 16,
    "automation.tree_nodes": 512,
    "filesystem.archive.create.sources": {
      "max": 1000,
      "min": 1
    },
    "filesystem.read.selected_bytes": {
      "max": 1048576,
      "min": 1
    },
    "filesystem.write.edit.replacements": {
      "max": 100,
      "min": 1
    },
    "network.capture.payload_preview_bytes": 4096,
    "network.capture.stop_wait_ms": 10000,
    "network.packet.decoded_bytes": {
      "max": 131072,
      "min": 1
    },
    "network.packet.payload_preview_bytes": 4096,
    "network.packet.tcp_flags": [
      "fin",
      "syn",
      "rst",
      "psh",
      "ack",
      "urg",
      "ece",
      "cwr"
    ],
    "request_dedup_max_records": 4096,
    "request_dedup_retention_hours": 24,
    "visual.display.rotation_degrees": [
      0,
      90,
      180,
      270
    ]
  },
  "store_schema_version": 1,
  "utf8_byte_bounds": [
    {
      "charset": "[a-z0-9_.-]",
      "max": 128,
      "min": 1,
      "path": "error.operation"
    },
    {
      "max": 4096,
      "path": "error.message"
    },
    {
      "max": 64,
      "min": 1,
      "path": "error.details.*.key"
    },
    {
      "max": 1024,
      "path": "error.details.*.string"
    },
    {
      "max": 255,
      "min": 1,
      "path": "context.status.device.timezone"
    },
    {
      "max": 256,
      "path": "context.status.device.manufacturer"
    },
    {
      "max": 256,
      "path": "context.status.device.model"
    },
    {
      "max": 256,
      "path": "context.status.device.device"
    },
    {
      "max": 256,
      "path": "context.status.device.build_fingerprint"
    },
    {
      "max": 128,
      "path": "context.status.components.*.version"
    },
    {
      "forbid_nul": true,
      "max": 32768,
      "min": 1,
      "path": "command.run.command"
    },
    {
      "forbid_nul": true,
      "max": 4096,
      "min": 1,
      "path": "command.run.cwd"
    },
    {
      "max": 65536,
      "path": "command.run.stdin"
    },
    {
      "charset": "ascii",
      "max": 32,
      "path": "network.inspect.sockets[].state"
    },
    {
      "max": 512,
      "path": "visual.observe.foreground.*"
    },
    {
      "max": 4096,
      "path": "visual.observe.nodes[].textual_fields"
    },
    {
      "max": 65536,
      "path": "visual.interact.text"
    },
    {
      "forbid_nul": true,
      "max": 255,
      "min": 1,
      "path": "android.*.package_name"
    },
    {
      "forbid_nul": true,
      "max": 512,
      "min": 1,
      "path": "android.*.class_name"
    },
    {
      "forbid_nul": true,
      "max": 4096,
      "path": "android.intent.*_uri"
    },
    {
      "max": 128,
      "min": 1,
      "path": "android.intent.extras.*.key"
    },
    {
      "max": 4096,
      "path": "android.intent.extras.*.string"
    },
    {
      "max": 65536,
      "path": "android.clipboard.write.text"
    },
    {
      "max": 256,
      "path": "android.notification.summary.title"
    },
    {
      "max": 512,
      "path": "android.notification.summary.text"
    },
    {
      "max": 512,
      "path": "android.notification.action.title"
    },
    {
      "max": 128,
      "min": 1,
      "path": "automation.name"
    },
    {
      "max": 64,
      "min": 1,
      "path": "automation.state.*.key"
    },
    {
      "max": 4096,
      "path": "automation.state.*.string"
    }
  ],
  "wire": {
    "default_inline_bytes": 65536,
    "default_list_items": 200,
    "error_detail_array_max_items": 32,
    "error_detail_key_max_utf8_bytes": 64,
    "error_detail_string_max_utf8_bytes": 1024,
    "error_details_max_encoded_utf8_bytes": 8192,
    "error_details_max_properties": 32,
    "error_message_max_utf8_bytes": 4096,
    "max_frame_bytes": 262144,
    "maximum_inline_bytes": 1048576,
    "maximum_list_items": 5000
  }
